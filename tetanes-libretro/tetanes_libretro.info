# Core metadata, which a frontend reads to name the core and describe what it can do.
#
# The filename has to match the library's - `tetanes_libretro.info` beside `tetanes_libretro.so` -
# or the frontend shows a bare filename instead of any of this.

display_name = "Nintendo - NES / Famicom (TetaNES)"
categories = "Emulator"
authors = "Luke Petherbridge"
corename = "TetaNES"
supported_extensions = "nes"
license = "MIT OR Apache-2.0"
permissions = ""
display_version = "0.14.2"

# Content this core plays, and the database the frontend matches ROMs against.
manufacturer = "Nintendo"
systemname = "Nintendo Entertainment System"
systemid = "nes"
database = "Nintendo - Nintendo Entertainment System"

# No BIOS or firmware: a NES cartridge is self-contained.
firmware_count = 0
notes = "Written in Rust. Save states, rewind and cheats are provided by the frontend.|If video stutters, check that Vertical Sync is on and that the Estimated Screen Refresh Rate matches your display: with V-Sync off, pacing falls to the audio driver alone and frames are dropped.|For faster fast-forward, enable Fast-Forward Frameskip - otherwise every skipped frame is still presented, which caps the speed at your refresh rate."

# Capabilities, which decide what the frontend offers in its menus. Kept honest as the phases land -
# a frontend that is told a core supports save states and finds it does not will simply fail.
savestate = "true"
# "deterministic", the strongest of the three, is what unlocks run-ahead and netplay: it claims a
# restored state replays the run it was taken from exactly, which is what
# `a_restored_state_replays_the_run_it_was_taken_from` checks.
savestate_features = "deterministic"
cheats = "true"
input_descriptors = "true"
memory_descriptors = "true"
libretro_saves = "true"
core_options = "true"
supports_no_game = "false"
hw_render = "false"
required_hw_api = ""
